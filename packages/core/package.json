{
  "name": "streamfold",
  "version": "0.1.21",
  "description": "Protocol-neutral incremental state for structured AI streams",
  "type": "module",
  "license": "MIT",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "!src/**/*.test.js"
  ],
  "exports": {
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    },
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ag-ui": {
      "types": "./src/ag-ui.d.ts",
      "default": "./src/ag-ui.js"
    },
    "./anthropic": {
      "types": "./src/anthropic.d.ts",
      "default": "./src/anthropic.js"
    },
    "./bedrock": {
      "types": "./src/bedrock.d.ts",
      "default": "./src/bedrock.js"
    },
    "./assistant-ui": {
      "types": "./src/assistant-ui.d.ts",
      "default": "./src/assistant-ui.js"
    },
    "./gemini": {
      "types": "./src/gemini.d.ts",
      "default": "./src/gemini.js"
    },
    "./langchain": {
      "types": "./src/langchain.d.ts",
      "default": "./src/langchain.js"
    },
    "./mistral": {
      "types": "./src/mistral.d.ts",
      "default": "./src/mistral.js"
    },
    "./pi": {
      "types": "./src/pi.d.ts",
      "default": "./src/pi.js"
    },
    "./openai": {
      "types": "./src/openai.d.ts",
      "default": "./src/openai.js"
    },
    "./openai-agents": {
      "types": "./src/openai-agents.d.ts",
      "default": "./src/openai-agents.js"
    },
    "./openrouter": {
      "types": "./src/openrouter.d.ts",
      "default": "./src/openrouter.js"
    },
    "./vercel-ai": {
      "types": "./src/vercel-ai.d.ts",
      "default": "./src/vercel-ai.js"
    },
    "./cohere": {
      "types": "./src/cohere.d.ts",
      "default": "./src/cohere.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/streamfold.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/assistant-ui/streamfold#readme",
  "bugs": {
    "url": "https://github.com/assistant-ui/streamfold/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "incremental",
    "json",
    "rust",
    "streaming",
    "tool-calling",
    "webassembly"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build-wasm.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "assistant-stream": "^0.3.54"
  },
  "peerDependenciesMeta": {
    "assistant-stream": {
      "optional": true
    }
  },
  "devDependencies": {
    "assistant-stream": "0.3.58"
  }
}
